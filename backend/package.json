{
  "name": "ai-trading-backend",
  "version": "1.0.0",
  "description": "Backend for AI Trading Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathIgnorePatterns=paperTrading.integration.test.js --testPathIgnorePatterns=paperTrading.e2e.test.js",
    "test:integration": "jest --runInBand paperTrading.integration.test.js paperTrading.e2e.test.js",
    "db:migrate": "node scripts/migrate.js up",
    "db:migrate:undo": "node scripts/migrate.js down",
    "create-admin": "node scripts/create-admin.js",
    "check": "npm test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "jest": "^29.3.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}

{
  "name": "ai-trading-platform",
  "version": "1.0.0",
  "description": "AI Trading Platform - A cutting-edge trading website showcasing generative AI capabilities for financial markets",
  "main": "index.js",
  "scripts": {
    "start": "concurrently \"npm run backend\" \"npm run frontend\"",
    "dev": "npm start",
    "backend": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev",
    "test": "npm --prefix backend run test:unit && npm --prefix frontend run build",
    "test:integration": "npm --prefix backend run test:integration",
    "db:migrate": "npm --prefix backend run db:migrate",
    "check": "npm test"
  },
  "keywords": [
    "ai",
    "trading",
    "finance",
    "machine-learning",
    "react",
    "nodejs",
    "express"
  ],
  "author": "AI Trading Team",
  "license": "MIT",
  "dependencies": {
    "concurrently": "^7.6.0",
    "recharts": "^3.1.0"
  }
}
